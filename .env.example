# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API Keys). Server only: the browser never
# talks to Supabase directly in v1.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Google Cloud Vertex AI
GOOGLE_CLOUD_PROJECT=
# "global" works for Gemini models; some models need a region such as us-central1
GOOGLE_CLOUD_LOCATION=global
# Base64 of a service account JSON key with the "Vertex AI User" role.
# Required on Vercel. Locally, leave empty and run:
#   gcloud auth application-default login
# Make one with: base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# Optional. Set when deployed to Vercel to lock the app behind one password.
APP_PASSWORD=
